t_6ef5b15d7485ea368edd65e8383460e68312ddb63cb25186cf90ff493770f7d0\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"cs_est\"\r\n\r\ntrue\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"ler\"\r\n\r\nempty\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"pmd[title]\"\r\n\r\nInsper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"pmd[locale]\"\r\n\r\npt\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"pmd[description]\"\r\n\r\nCursos de graduação, pós-graduação e curta duração com qualidade reconhecida internacionalmente\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"plt\"\r\n\r\n250\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"iss\"\r\n\r\n1\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"ss\"\r\n\r\n{\"page_title\":[{\"rid\":\"1672614330481387\",\"v\":[\"Estratégia e Governança: Fusões e Aquisições\"]},{\"rid\":\"2835737990141341\",\"v\":[\"EDUCAÇÃO EXECUTIVA\"]},{\"rid\":\"1621700756244233\",\"v\":[\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\"]}],\"image_url\":[{\"rid\":\"2223205584906888\",\"v\":[\"https://www.insper.edu.br/content/dam/insper-portal/imagens/Logos/e-mec.png\"]}],\"page_description\":[{\"rid\":\"1745204003472925\",\"v\":[\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\"]}],\"availability\":[{\"rid\":\"3242480875945277\",\"v\":[\"in stock\"]}],\"all_entity_images\":[{\"rid\":\"1758370868707401\",\"v\":[\"https://www.insper.edu.br/content/dam/insper-portal/imagens/educa%C3%A7%C3%A3o-executiva/educacao_executiva_01.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/mbm-Portfolio_Mkt%20Insper_Abril_2024_@dubillafoto_21021.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/institucional/Universidade%20de%20Chicago.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/Alunos%20da%20P%C3%B3s%20180bx.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/campus/jcr:content/cq:discarded/6fbd61ab-102a-4e4d-9513-4a95cd4add60/_FSC4996_PAGP.jpg\",\"https://www.insper.edu.br/content/dam/insper-portal/imagens/gradua%C3%A7%C3%A3o/ilustra%20women%20in%20finance.png\"]}],\"author\":[{\"rid\":\"1774445787132675\",\"v\":[\"O Insper\"]},{\"rid\":\"1812133733470798\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]}],\"page_keywords\":[{\"rid\":\"1749153822858725\",\"v\":[\"INSTITUCIONAL\"]}],\"event_description\":[{\"rid\":\"1050716624454535\",\"v\":[\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\",\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\",\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\",\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\",\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\",\"Um programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança.\"]}],\"page_type\":[{\"rid\":\"2359109971162751\",\"v\":[\"EDUCAÇÃO EXECUTIVA\\n\\nEstratégia e Governança: Fusões e Aquisições\\n\\nDomine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\n\\nConheça o curso\",\"PÓS-GRADUAÇÃO\\n\\nPós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\\n\\nEntenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\n\\nAcesse e saiba mais\",\"PARCERIAS\\n\\nInsper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\\n\\nParceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\n\\nSaiba mais\",\"ON-LINE\\n\\nCarreira em movimento: como se preparar hoje para os desafios do futuro\\n\\n29 SET (TER)\\n\\n • 19h\\n\\n - 20h30\\n\\nUm encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\n\\nInscreva-se gratuitamente\",\"PÓS-GRADUAÇÃO\\n\\nPor que deixar para 2027 o que você pode fazer agora pela sua carreira?\\n\\nComece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\\n\\nConheça os cursos e inscreva-se\",\"PROGRAMAS DE FÉRIAS\\n\\nWomen in Finance and Leadership\\n\\n18 - 22 JAN (SEG - SEX)\\n\\n • 08h30\\n\\n - 18h\\n\\nUm programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança. \\n\\nInscreva-se e participe\"]}],\"publisher\":[{\"rid\":\"1475377134645541\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]},{\"rid\":\"1088227847395950\",\"v\":[\"Vestibular\",\"O Insper\"]},{\"rid\":\"1092945933622130\",\"v\":[\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\"]}],\"entity_description\":[{\"rid\":\"2503468310119232\",\"v\":[\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\",\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\",\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\",\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\",\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\",\"Um programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança.\"]}],\"event_location\":[{\"rid\":\"1095637196502648\",\"v\":[\"Vestibular\",\"O Insper\"]}]}\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"imft\"\r\n\r\n1\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"tz\"\r\n\r\n-180\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"it\"\r\n\r\n1790558517620\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"coo\"\r\n\r\nfalse\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"cf\"\r\n\r\n1\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"expv2[0]\"\r\n\r\npl0\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"expv2[1]\"\r\n\r\nel2\r\n------geckoformboundary15163d3f248f06e5d2ccf5418f955a3b\r\nContent-Disposition: form-data; name=\"expv2[2]\"\r\n\r\nbc1\r