            "text": "{\"fragmentPath\":null,\"language\":\"pt\",\"title\":\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\",\"lastModifiedDate\":1790254099550,\"templateName\":\"spa-page-template\",\"cssClassNames\":\"page basicpage\",\"htmlPageItems\":[],\"designPath\":\"/libs/settings/wcm/designs/default\",\"brandSlug\":\"\",\"componentsResourceTypes\":[\"insper-portal/components/cookieConsent\",\"insper-portal/components/footer\",\"insper-portal/components/eventCarousel\",\"insper-portal/components/genericbanneritem\",\"nt:folder\",\"insper-portal/components/courseSearchBar\",\"insper-portal/components/structure/container\",\"insper-portal/components/spacer\",\"insper-portal/components/header\",\"insper-portal/components/structure/page\",\"insper-portal/components/genericbanner\",\"nt:unstructured\",\"insper-portal/components/fragments/experiencefragment\",\"insper-portal/components/structure/xfpage\",\"insper-portal/components/containergrid/wrapper\",\"nt:file\",\"insper-portal/components/featuredCard\",\"insper-portal/components/footerQrCode\",\"insper-portal/components/shortcutCards\",\"insper-portal/components/featuredCardContainer/container\",\"insper-portal/components/containergrid/container\",\"insper-portal/components/featuredBanner\",\"wcm/foundation/components/responsivegrid\",\"insper-portal/components/text-v2\",\"nt:resource\",\"insper-portal/components/footerLinks\",\"insper-portal/components/featuredCardContainer/wrapper\",\"insper-portal/components/newsList\"],\"genericContentFragmentData\":null,\"jsontoLLM\":\"[{\\\"subtitle\\\":\\\"Insper - Home Page\\\",\\\"jcr:title\\\":\\\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\\\",\\\"jcr:description\\\":\\\"Cursos de graduação, pós-graduação e curta duração com qualidade reconhecida internacionalmente\\\",\\\"pageTitle\\\":\\\"Insper: Ensino Superior em Negócios, Direito, Engenharias e Ciência da Computação\\\",\\\"navTitle\\\":\\\"Insper - Home Page\\\"},{\\\"richText\\\":\\\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\\",\\\"madeBy\\\":\\\"Por\\\",\\\"tag\\\":\\\"programas:pós-graduação\\\",\\\"buttonUrl\\\":\\\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\\\",\\\"title\\\":\\\"Pós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\\\",\\\"variant\\\":\\\"imagecolor\\\",\\\"buttonText\\\":\\\"Acesse e saiba mais\\\",\\\"linkRedirect\\\":\\\"https://www.insper.edu.br/pt/conteudos/gestao-e-negocios/pos-graduacao-modular-como-funciona-e-quais-sao-as-vantagens-para-jovens-profissionais\\\"},{\\\"jcr:title\\\":\\\"vermelho / amarelo / preto\\\"},{\\\"themeName\\\":\\\"vermelho / amarelo / preto\\\",\\\"backgroundColor\\\":\\\"rgb(229,5,5)\\\"},{\\\"richText\\\":\\\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\\",\\\"madeBy\\\":\\\"Por\\\",\\\"tag\\\":\\\"tipos-de-conteudo:acontece-no-insper/parcerias\\\",\\\"buttonUrl\\\":\\\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\\\",\\\"title\\\":\\\"Insper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\\\",\\\"variant\\\":\\\"imagecolor\\\",\\\"buttonText\\\":\\\"Saiba mais\\\",\\\"linkRedirect\\\":\\\"https://www.insper.edu.br/pt/conteudos/acontece-no-insper/insper-celebra-25-anos-de-parceria-com-a-university-of-chicago-e-recebe-programa-inedito-para-ensino-medio-no-brasil\\\"},{\\\"jcr:title\\\":\\\"turquesa / preto / vermelho\\\"},{\\\"themeName\\\":\\\"turquesa / preto / vermelho\\\"},{\\\"startHour\\\":\\\"19h00\\\",\\\"endHour\\\":\\\"20h30\\\",\\\"richText\\\":\\\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\\",\\\"madeBy\\\":\\\"Por\\\",\\\"tag\\\":\\\"tipos-de-evento:online\\\",\\\"buttonUrl\\\":\\\"https://www.insper.edu.br/pt/eventos/2026/09/carreira-em-movimento-desafios-do-futuro\\\",\\\"title\\\":\\\"Carreira em movimento: como se preparar hoje para os desafios do futuro\\\",\\\"variant\\\":\\\"imagecolor\\\",\\\"buttonText\\\":\\\"Inscreva-se gratuitamente\\\",\\\"linkRedirect\\\":\\\"https://www.insper.edu.br/pt/eventos/2026/09/carreira-em-movimento-desafios-do-futuro\\\"},{\\\"jcr:title\\\":\\\"azul marinho / turquesa / vermelho\\\"},{\\\"@stringArray@variations_0\\\":\\\"azul_marinho_rosaturquesa\\\"},{\\\"jcr:title\\\":\\\"azul marinho / rosa / turquesa\\\",\\\"name\\\":\\\"azul_marinho_rosaturquesa\\\",\\\"jcr:description\\\":\\\"azul marinho / rosa / turquesa\\\"},{\\\"synchronizeWithVersion_0\\\":\\\"themeName:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_1\\\":\\\"titleFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_2\\\":\\\"titleBackgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_3\\\":\\\"thinLineFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_4\\\":\\\"additionalDataFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_5\\\":\\\"linkFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_6\\\":\\\"linkHoverFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_7\\\":\\\"backgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_8\\\":\\\"gradientColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_9\\\":\\\"buttonFontColor:e1d1d653-cff0-4cbb-bae9-7676f42d5f08\\\",\\\"synchronizeWithVersion_10\\\":\\\"buttonBackgroundColor:e1d1d653-cff0-4cbb-bae9-7676f42