          "postData": {
            "mimeType": "text/plain;charset=UTF-8",
            "params": [],
            "text": "{\"event_name\":\"PageView\",\"smart_setup\":{\"auto_web_details_data\":\"{\\\"page_title\\\":[{\\\"rid\\\":\\\"1672614330481387\\\",\\\"v\\\":[\\\"Estratégia e Governança: Fusões e Aquisições\\\"]},{\\\"rid\\\":\\\"2835737990141341\\\",\\\"v\\\":[\\\"EDUCAÇÃO EXECUTIVA\\\"]},{\\\"rid\\\":\\\"1621700756244233\\\",\\\"v\\\":[\\\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\\"]}],\\\"image_url\\\":[{\\\"rid\\\":\\\"2223205584906888\\\",\\\"v\\\":[\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/Logos/e-mec.png\\\"]}],\\\"page_description\\\":[{\\\"rid\\\":\\\"1745204003472925\\\",\\\"v\\\":[\\\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\\"]}],\\\"availability\\\":[{\\\"rid\\\":\\\"3242480875945277\\\",\\\"v\\\":[\\\"in stock\\\"]}],\\\"all_entity_images\\\":[{\\\"rid\\\":\\\"1758370868707401\\\",\\\"v\\\":[\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/educa%C3%A7%C3%A3o-executiva/educacao_executiva_01.jpg\\\",\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/mbm-Portfolio_Mkt%20Insper_Abril_2024_@dubillafoto_21021.jpg\\\",\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/institucional/Universidade%20de%20Chicago.jpg\\\",\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/aulas/Alunos%20da%20P%C3%B3s%20180bx.jpg\\\",\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/campus/jcr:content/cq:discarded/6fbd61ab-102a-4e4d-9513-4a95cd4add60/_FSC4996_PAGP.jpg\\\",\\\"https://www.insper.edu.br/content/dam/insper-portal/imagens/gradua%C3%A7%C3%A3o/ilustra%20women%20in%20finance.png\\\"]}],\\\"author\\\":[{\\\"rid\\\":\\\"1774445787132675\\\",\\\"v\\\":[\\\"O Insper\\\"]},{\\\"rid\\\":\\\"1812133733470798\\\",\\\"v\\\":[\\\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\\\"]}],\\\"page_keywords\\\":[{\\\"rid\\\":\\\"1749153822858725\\\",\\\"v\\\":[\\\"INSTITUCIONAL\\\"]}],\\\"event_description\\\":[{\\\"rid\\\":\\\"1050716624454535\\\",\\\"v\\\":[\\\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\\",\\\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\\",\\\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\\",\\\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\\",\\\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\\\",\\\"Um programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança.\\\"]}],\\\"page_type\\\":[{\\\"rid\\\":\\\"2359109971162751\\\",\\\"v\\\":[\\\"EDUCAÇÃO EXECUTIVA\\\\n\\\\nEstratégia e Governança: Fusões e Aquisições\\\\n\\\\nDomine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\\\n\\\\nConheça o curso\\\",\\\"PÓS-GRADUAÇÃO\\\\n\\\\nPós-graduação modular: como funciona e quais são as vantagens para jovens profissionais\\\\n\\\\nEntenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\\\n\\\\nAcesse e saiba mais\\\",\\\"PARCERIAS\\\\n\\\\nInsper celebra 25 anos de parceria com a University of Chicago e recebe programa inédito para ensino médio no Brasil\\\\n\\\\nParceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\\\n\\\\nSaiba mais\\\",\\\"ON-LINE\\\\n\\\\nCarreira em movimento: como se preparar hoje para os desafios do futuro\\\\n\\\\n29 SET (TER)\\\\n\\\\n • 19h\\\\n\\\\n - 20h30\\\\n\\\\nUm encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\\\n\\\\nInscreva-se gratuitamente\\\",\\\"PÓS-GRADUAÇÃO\\\\n\\\\nPor que deixar para 2027 o que você pode fazer agora pela sua carreira?\\\\n\\\\nComece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\\\\n\\\\nConheça os cursos e inscreva-se\\\",\\\"PROGRAMAS DE FÉRIAS\\\\n\\\\nWomen in Finance and Leadership\\\\n\\\\n18 - 22 JAN (SEG - SEX)\\\\n\\\\n • 08h30\\\\n\\\\n - 18h\\\\n\\\\nUm programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança. \\\\n\\\\nInscreva-se e participe\\\"]}],\\\"publisher\\\":[{\\\"rid\\\":\\\"1475377134645541\\\",\\\"v\\\":[\\\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\\\"]},{\\\"rid\\\":\\\"1088227847395950\\\",\\\"v\\\":[\\\"Vestibular\\\",\\\"O Insper\\\"]},{\\\"rid\\\":\\\"1092945933622130\\\",\\\"v\\\":[\\\"Saiba como o Insper trata os seus dados pessoais em nosso Aviso de Privacidade, disponível no Portal da Privacidade.\\\"]}],\\\"entity_description\\\":[{\\\"rid\\\":\\\"2503468310119232\\\",\\\"v\\\":[\\\"Domine as decisões que fazem a diferença em uma operação de M&A, da estratégia e valuation à negociação, aspectos jurídicos e integração.\\\",\\\"Entenda como a pós-graduação modular combina flexibilidade, personalização e desenvolvimento profissional para quem está no início da carreira.\\\",\\\"Parceria com a University of Chicago ganha novo capítulo com a chegada de um programa inédito voltado a estudantes do ensino médio no Brasil.\\\",\\\"Um encontro sobre as transformações do mercado de trabalho e as competências essenciais para construir uma carreira preparada para o futuro.\\\",\\\"Comece sua pós-graduação no Insper ainda em 2026. Entenda as vantagens.\\\",\\\"Um programa de férias pensado para jovens mulheres do ensino médio que querem ampliar suas possibilidades de futuro e carreira na área de Finanças e Liderança.\\\"]}],\\\"event_location\\\":[{\\\"rid\\\":\\\"1095637196502648\\\",\\\"v\\\":[\\\"Vestibular\\\",\\\"O Insper\\\"]}]}\",\"is_auto_web_details\":true},\"event_id\":\"ob3_plugin-set_6ef5b15d7485ea368edd65e8383460e68312ddb63cb25186cf90ff493770f7d0\",\"fb.pixel_id\":\"2668250199923325\",\"website_context\":{\"location\":\"https://www.insper.edu.br/pt/home\",\"referrer\":\"\",\"isInIFrame\":false},\"fb.fbp\":\"fb.2.1790552045794.971948840264591298\",\"event_meta_info\":{\"cs_est\":true}}"
          }
