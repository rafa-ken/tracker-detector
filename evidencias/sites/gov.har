efault\">\n            <div class=\"nitf-basic-tile tile-content\">\n              <a class=\"imag\" target=\"_blank\" href=\"http://agenciagov.ebc.com.br/noticias/202609/presidente-lula-assina-medida-provisoria-que-proibe-as-bets-no-brasil\">\n                <img src=\"http://agenciagov.ebc.com.br/noticias/202609/presidente-lula-assina-medida-provisoria-que-proibe-as-bets-no-brasil/@@images/image/large\" alt=\"Fabio Rodrigues-Pozzebom /Agência Brasil\" />\n              </a>\n\n              <p class=\"tile-subtitle\">Saúde</p>\n\n              <h2><a target=\"_blank\" href=\"http://agenciagov.ebc.com.br/noticias/202609/presidente-lula-assina-medida-provisoria-que-proibe-as-bets-no-brasil\">Bets e jogos online estão proibidos: confira o cronograma das novas medidas</a></h2>\n              <div class=\"visualClear\"><!-- --></div>\n            </div>\n          </div>\n        </div>\n      \n        <div class=\"column col-md-4\">\n          <div class=\"tile tile-default\">\n            <div class=\"nitf-basic-tile tile-content\">\n              <a class=\"imag\" target=\"_blank\" href=\"http://agenciagov.ebc.com.br/noticias/202609/receita-federal-tira-duvida-sobre-opcao-pelo-simei-que-permanece-com-prazo-definido-para-janeiro\">\n                <img src=\"http://agenciagov.ebc.com.br/noticias/202609/receita-federal-tira-duvida-sobre-opcao-pelo-simei-que-permanece-com-prazo-definido-para-janeiro/@@images/image/large\" alt=\"Divulgação\" />\n              </a>\n\n              <p class=\"tile-subtitle\">Economia</p>\n\n              <h2><a target=\"_blank\" href=\"http://agenciagov.ebc.com.br/noticias/202609/receita-federal-tira-duvida-sobre-opcao-pelo-simei-que-permanece-com-prazo-definido-para-janeiro\">Prazo para optar pelo Simei termina em janeiro, informa Receita Federal</a></h2>\n              <div class=\"visualClear\"><!-- --></div>\n            </div>\n          </div>\n        </div>\n      \n        <div class=\"column col-md-4\">\n          <div class